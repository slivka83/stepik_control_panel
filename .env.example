# Stepik OAuth2
STEPIK_CLIENT_ID=your_client_id
STEPIK_CLIENT_SECRET=your_client_secret
# Numeric Stepik user id of the course author (used by /courses?teacher=).
# Leave 0 on a fresh install: the first account that logs in becomes the panel
# owner (all later logins from other accounts are rejected). If the token owner
# cannot be resolved during sync, the sync is aborted instead of wiping data.
STEPIK_USER_ID=0

# Finance OAuth2 (client_credentials)
STEPIK_FINANCE_CLIENT_ID=your_finance_client_id
STEPIK_FINANCE_CLIENT_SECRET=your_finance_client_secret

# Encryption key for tokens (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key_here

# Session signing secret (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here
SESSION_TTL_HOURS=24

# Database
DATABASE_URL=postgresql+asyncpg://stepik_panel:stepik_panel@localhost:5433/stepik_panel
POSTGRES_USER=stepik_panel
POSTGRES_PASSWORD=stepik_panel
POSTGRES_DB=stepik_panel
POSTGRES_PORT=5433

# Redis
REDIS_URL=redis://:stepik_redis@localhost:6380/0
REDIS_PORT=6380
REDIS_PASSWORD=stepik_redis

# App
APP_ENV=development
ALLOWED_ORIGINS=
# Optional: public URL used in the OAuth redirect (default http://localhost:FRONTEND_PORT)
# FRONTEND_URL_OVERRIDE=
# Optional: exact OAuth callback URL registered in the Stepik app
# STEPIK_REDIRECT_URI_OVERRIDE=

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
