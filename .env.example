# Stepik OAuth2
STEPIK_CLIENT_ID=your_client_id
STEPIK_CLIENT_SECRET=your_client_secret
STEPIK_USER_ID=0

# Finance OAuth2 (client_credentials)
STEPIK_FINANCE_CLIENT_ID=your_finance_client_id
STEPIK_FINANCE_CLIENT_SECRET=your_finance_client_secret

# Encryption key for tokens (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key_here

# Session signing secret (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here
SESSION_TTL_HOURS=24

# Database
DATABASE_URL=postgresql+asyncpg://stepik_panel:stepik_panel@localhost:5433/stepik_panel
POSTGRES_USER=stepik_panel
POSTGRES_PASSWORD=stepik_panel
POSTGRES_DB=stepik_panel
POSTGRES_PORT=5433

# Redis
REDIS_URL=redis://localhost:6380/0
REDIS_PORT=6380
REDIS_PASSWORD=stepik_redis

# App
APP_ENV=development
ALLOWED_ORIGINS=

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
